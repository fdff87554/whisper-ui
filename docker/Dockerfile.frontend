# Stage 1: Build CSS
FROM node:25-alpine AS css-builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY src/whisper_ui/web/static/css/ ./src/whisper_ui/web/static/css/
COPY src/whisper_ui/web/templates/ ./src/whisper_ui/web/templates/
RUN npx @tailwindcss/cli -i src/whisper_ui/web/static/css/input.css \
    -o src/whisper_ui/web/static/style.css --minify

# Stage 2: Python app
FROM python:3.13-slim
WORKDIR /app

ARG PIP_INDEX_URL=
ENV PIP_INDEX_URL=${PIP_INDEX_URL}

# Dependency layer: only project metadata plus a stub package, so editing
# src/ does not invalidate the dependency install below. Versions are
# pinned to uv.lock via an exported constraints file, so the shipped image
# runs the same versions CI tested (and pip-audit scanned).
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock ./
RUN mkdir -p src/whisper_ui && touch src/whisper_ui/__init__.py && \
    uv export --frozen --no-emit-project --no-hashes --extra frontend -o /tmp/constraints.txt && \
    pip install --no-cache-dir -c /tmp/constraints.txt ".[frontend]"

# Project layer: the compiled stylesheet must land inside src/ before the
# final install so it ships as package data. --force-reinstall replaces the
# stub install of whisper-ui itself; --no-deps keeps the layer cheap.
COPY src/ ./src/
COPY --from=css-builder /app/src/whisper_ui/web/static/style.css \
     ./src/whisper_ui/web/static/style.css
RUN pip install --no-cache-dir --no-deps --force-reinstall .

RUN useradd --uid 1000 --create-home appuser 2>/dev/null || true \
    && mkdir -p /app/data/db /app/data/uploads /app/data/outputs \
    && chown -R 1000 /app/data
USER 1000

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# --no-access-log: silences uvicorn's stock access log; replaced by the
# structured access log emitted from whisper_ui.web.middleware.request_id,
# which includes user_id, request_id, and duration_ms (the stock log has
# none of those).
# --no-server-header: drop the "Server: uvicorn" response header so the app
# does not advertise its server software to every client.
CMD ["uvicorn", "whisper_ui.web.app:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log", "--no-server-header"]
